- publisher

```jsx
#include "ros/ros.h"
#include "geometry_msgs/Twist.h"  // cmd_vel 메시지 타입

int main(int argc, char **argv)
{
    ros::init(argc, argv, "cmd_vel_publisher");
    ros::NodeHandle n;

    // Create a publisher for the /cmd_vel topic
    ros::Publisher pub = n.advertise<geometry_msgs::Twist>("/cmd_vel", 10);

    ros::Rate loop_rate(10);  // 10 Hz

    while (ros::ok())
    {
        // Create a Twist message
        geometry_msgs::Twist msg;
        msg.linear.x = 0.5;  // Example linear velocity (m/s)
        msg.angular.z = 0.2; // Example angular velocity (rad/s)

        // Publish the message
        pub.publish(msg);
        ROS_INFO("Published cmd_vel: linear.x=%.2f, angular.z=%.2f", msg.linear.x, msg.angular.z);

        loop_rate.sleep();
    }

    return 0;
}

```

