#include "ros/ros.h"
#include "std_msgs/Bool.h"
#include "std_msgs/Int16.h"
#include "geometry_msgs/Twist.h"  // cmd_vel 메시지 타입

// Global variables for publishers
ros::Publisher pub_right;
ros::Publisher pub_left;

// Callback function for cmd_vel topic
void cmdVelCallback(const geometry_msgs::Twist::ConstPtr& msg)
{
    // Extract linear.x for right motor and angular.z for left motor (example logic)
    int16_t pulsewidth_r = static_cast<int16_t>(msg->linear.x * 100);  // Scale as needed
    int16_t pulsewidth_l = static_cast<int16_t>(msg->angular.z * 100); // Scale as needed

    // Publish pulsewidth values
    std_msgs::Int16 right_msg;
    std_msgs::Int16 left_msg;

    right_msg.data = pulsewidth_r;
    left_msg.data = pulsewidth_l;

    pub_right.publish(right_msg);
    pub_left.publish(left_msg);

    ROS_INFO("Published pulsewidth_r: %d, pulsewidth_l: %d", pulsewidth_r, pulsewidth_l);
}

int main(int argc, char **argv)
{
    ros::init(argc, argv, "c620_robomaster_control");
    ros::NodeHandle n;

    // Initialize publishers
    pub_right = n.advertise<std_msgs::Int16>("robot_control/pulsewidth_r", 10);
    pub_left = n.advertise<std_msgs::Int16>("robot_control/pulsewidth_l", 10);

    // Initialize subscriber
    ros::Subscriber sub = n.subscribe("/cmd_vel", 10, cmdVelCallback);

    ros::Rate loop_rate(25);

    while (ros::ok())
    {
        ros::spinOnce();  // Process incoming messages
        loop_rate.sleep();
    }

    return 0;
}

